{
	"name": "bitburner-link",
	"version": "0.1.0",
	"description": "Sync your Bitburner scripts with the game over the Remote API: content diff on connect, RAM report on every push, pull files back from the game.",
	"keywords": ["bitburner", "filesync", "remote-api", "netscript"],
	"license": "MIT",
	"author": "Allan Kimmer Jensen",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Saturate/bitburner-link.git"
	},
	"homepage": "https://github.com/Saturate/bitburner-link#readme",
	"bugs": "https://github.com/Saturate/bitburner-link/issues",
	"type": "module",
	"bin": {
		"bitburner-link": "dist/src/cli.js"
	},
	"files": ["dist/src", "README.md", "LICENSE"],
	"engines": {
		"node": ">=20"
	},
	"scripts": {
		"build": "tsc",
		"start": "node dist/src/cli.js",
		"test": "tsc && node --test \"dist/test/**/*.test.js\""
	},
	"dependencies": {
		"ws": "^8.18.0"
	},
	"devDependencies": {
		"@types/node": "^20.17.0",
		"@types/ws": "^8.5.12",
		"typescript": "^5.8.3"
	}
}
